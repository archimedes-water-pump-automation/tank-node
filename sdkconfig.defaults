CONFIG_IDF_TARGET="esp32c3"

# 1 ms tick. The default 100 Hz gives vTaskDelay a 10 ms granularity,
# which is too coarse for the control loop's timing assumptions.
CONFIG_FREERTOS_HZ=1000

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Level messages are only useful while fresh.
CONFIG_MQTT_OUTBOX_EXPIRED_TIMEOUT_MS=10000
